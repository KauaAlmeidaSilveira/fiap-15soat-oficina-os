# Copie para .env (gitignorado).

# Ativa o New Relic no docker-compose.
NEW_RELIC_LICENSE_KEY=<license-key-do-new-relic>

# Mercado Pago real (credenciais de teste). Só vale com docker-compose.mercadopago.yml;
# sem ele, o Billing usa o WireMock.
MERCADOPAGO_ACCESS_TOKEN=<access-token-de-teste>
MERCADOPAGO_EXTERNAL_POS_ID=<external-id-do-caixa>
MERCADOPAGO_WEBHOOK_SECRET=<assinatura-secreta-do-webhook>
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
