# Referencia apenas: os Secrets sao criados pelo scripts/deploy-aws.sh do repositorio do OS,
# a partir do .env, dos outputs do Terraform e de .local/chaves. Nunca commitar valores reais.
apiVersion: v1
kind: Secret
metadata:
  name: oficina-os-secrets
  namespace: oficina
type: Opaque
stringData:
  DB_PASSWORD: "<DB_PASSWORD>"
  NEW_RELIC_LICENSE_KEY: "<NEW_RELIC_LICENSE_KEY>"
---
apiVersion: v1
kind: Secret
metadata:
  name: oficina-os-chaves
  namespace: oficina
type: Opaque
stringData:
  sessao.public.key: |
    <conteudo de sessao.public.key>
  servico.private.key: |
    <conteudo de servico.private.key>
  servico.public.key: |
    <conteudo de servico.public.key>
